<!-- progressive enhancement only: the grid-overlay toggle -->
<script is:inline>
(function(){
  var btn=document.getElementById('gridToggle');
  function setGrid(on){
    document.body.classList.toggle('grid-on',on);
    if(btn) btn.setAttribute('aria-pressed',on?'true':'false');
  }
  if(btn) btn.addEventListener('click',function(){
    setGrid(!document.body.classList.contains('grid-on'));
  });
  document.addEventListener('keydown',function(e){
    if((e.key==='g'||e.key==='G')&&!e.metaKey&&!e.ctrlKey&&!e.altKey
       &&!/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName))
      setGrid(!document.body.classList.contains('grid-on'));
  });
  var host=document.querySelector('.guides .cols');
  if(host){
    var n=parseInt(getComputedStyle(document.documentElement).getPropertyValue('--cols'),10)||12;
    for(var i=1;i<=n;i++){
      var c=document.createElement('div');c.className='col';
      var s=document.createElement('span');s.textContent=i;
      c.appendChild(s);host.appendChild(c);
    }
  }
})();
</script>
